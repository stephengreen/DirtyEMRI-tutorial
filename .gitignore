# pixi environment (rebuilt from pixi.toml / pixi.lock)
.pixi/

# compiled FEW extensions + build artifacts (rebuilt by build_few.py)
FastEMRIWaveforms/*.so
FastEMRIWaveforms/build/
FastEMRIWaveforms/few/_version.py
# Cython-generated C/C++ and the cpu-copies setup.py makes
FastEMRIWaveforms/src/*.cpp
FastEMRIWaveforms/src/*_cpu.pyx
# files generated by ode_prepare() at build time
FastEMRIWaveforms/few/utils/odeoptions.py
FastEMRIWaveforms/src/ode.cc
FastEMRIWaveforms/include/ode.hh

# nbconvert verification output
_verify_run.ipynb

# python / jupyter cruft
__pycache__/
*.pyc
.ipynb_checkpoints/
